{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nurl-lang.org/schemas/nurl-cert/1/manifest.json",
  "title": "nurl-cert/1 manifest",
  "description": "manifest.json of a NURL certificate bundle (docs/dev/CERTIFICATE.md, AGORA-1019).",
  "type": "object",
  "required": [
    "schema",
    "tool",
    "profile",
    "program",
    "claims",
    "coverage",
    "hashes",
    "versions",
    "ledger"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "proved",
        "validated",
        "assumed",
        "open",
        "refuted",
        "not-claimed"
      ]
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "lean",
        "status",
        "sentence",
        "reason",
        "axioms",
        "premises"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[MFNB]\\.[A-Za-z0-9_.]+$"
        },
        "lean": {
          "type": "string",
          "description": "the theorem's Lean name; empty for a claim no theorem states"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "sentence": {
          "type": "object",
          "required": [
            "en",
            "fi"
          ],
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "string"
            },
            "fi": {
              "type": "string"
            }
          }
        },
        "reason": {
          "type": "string"
        },
        "axioms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "premises": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ledger row ids"
        }
      }
    },
    "row": {
      "type": "object",
      "required": [
        "id",
        "what",
        "why",
        "where",
        "vouches",
        "claims"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "what": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "where": {
          "type": "string"
        },
        "vouches": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "nurl-cert/1"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "nurl-cert"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "profile": {
      "enum": [
        "kernel",
        "fast"
      ]
    },
    "program": {
      "type": "object",
      "required": [
        "source",
        "verdict",
        "reason",
        "slots"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "accepted",
            "refused",
            "unsupported",
            "error"
          ]
        },
        "reason": {
          "type": "string"
        },
        "slots": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "description": "M.safe, M.leak, M.unsafe, then N.cap; a threaded program: M.safe, M.leak, M.race, M.unsafe, then N.cap",
      "oneOf": [
        {
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "properties": {
                "id": {
                  "const": "M.safe"
                },
                "lean": {
                  "const": "Cert.m_safe"
                }
              }
            },
            {
              "properties": {
                "id": {
                  "const": "M.leak"
                },
                "lean": {
                  "const": "Cert.m_leak"
                }
              }
            },
            {
              "properties": {
                "id": {
                  "const": "M.unsafe"
                },
                "lean": {
                  "const": ""
                },
                "status": {
                  "enum": [
                    "assumed",
                    "open"
                  ]
                }
              }
            },
            {
              "properties": {
                "id": {
                  "const": "N.cap"
                },
                "lean": {
                  "const": "Cert.n_cap"
                }
              }
            }
          ]
        },
        {
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {
              "properties": {
                "id": {
                  "const": "M.safe"
                },
                "lean": {
                  "const": "Cert.m_safe"
                }
              }
            },
            {
              "properties": {
                "id": {
                  "const": "M.leak"
                },
                "lean": {
                  "const": "Cert.m_leak"
                }
              }
            },
            {
              "properties": {
                "id": {
                  "const": "M.race"
                },
                "lean": {
                  "const": "Cert.m_race"
                }
              }
            },
            {
              "properties": {
                "id": {
                  "const": "M.unsafe"
                },
                "lean": {
                  "const": ""
                },
                "status": {
                  "enum": [
                    "assumed",
                    "open"
                  ]
                }
              }
            },
            {
              "properties": {
                "id": {
                  "const": "N.cap"
                },
                "lean": {
                  "const": "Cert.n_cap"
                }
              }
            }
          ]
        }
      ]
    },
    "coverage": {
      "type": "object",
      "required": [
        "functions"
      ],
      "properties": {
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "file",
              "line",
              "status",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "proved",
                  "validated",
                  "open",
                  "refused",
                  "unsupported",
                  "error"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "hashes": {
      "type": "object",
      "required": [
        "sources",
        "core_ir"
      ],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "minItems": 1
        },
        "core_ir": {
          "$ref": "#/$defs/sha256"
        },
        "llvm_ir": {
          "$ref": "#/$defs/sha256"
        },
        "program_lean": {
          "$ref": "#/$defs/sha256"
        },
        "claims_lean": {
          "$ref": "#/$defs/sha256"
        },
        "elab_lean": {
          "$ref": "#/$defs/sha256",
          "description": "Elab.lean: present exactly when the bundle has it, which records that the kernel built the term from the core IR's words (Cert.elab; nurl-cert 0.2.0)"
        },
        "binary": {
          "$ref": "#/$defs/file"
        },
        "caps_lean": {
          "$ref": "#/$defs/sha256",
          "description": "Caps.lean (N.cap proved)"
        },
        "caps_tsv": {
          "$ref": "#/$defs/sha256",
          "description": "caps.tsv, the capability table the classes are read with (N.cap proved)"
        }
      }
    },
    "versions": {
      "type": "object",
      "required": [
        "nurlc",
        "formal_tree",
        "formal_commit",
        "lean_toolchain"
      ],
      "additionalProperties": false,
      "properties": {
        "nurlc": {
          "type": "string"
        },
        "formal_tree": {
          "$ref": "#/$defs/sha256"
        },
        "formal_commit": {
          "type": "string"
        },
        "lean_toolchain": {
          "type": "string"
        }
      }
    },
    "ledger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "minItems": 1
    },
    "capabilities": {
      "type": "object",
      "description": "N.cap (AGORA-1013), present when it is proved: the functions a run can enter (the term's indices, Caps.lean's list), each program function among them with the classes its core IR calls reach, and each class with one shortest chain of calls from a function in the list to the runtime function that has it",
      "required": [
        "runs",
        "functions",
        "classes"
      ],
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "name",
              "classes"
            ],
            "additionalProperties": false,
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "type": "string"
              },
              "classes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "class",
              "chain"
            ],
            "additionalProperties": false,
            "properties": {
              "class": {
                "type": "string"
              },
              "chain": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
