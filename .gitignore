# ─── Build artefacts ──────────────────────────────────────────
build/
nurlc
nurlc.wasm
*.exe
*.dll
*.o
*.obj
*.ll
*.wasm

# Playground demo wasm modules are shipped assets, not build output — they must
# ride in the deployed image (the CI deploy builds from the committed tree).
!nurlapi/static/c64.wasm
!nurlapi/static/gameboy_gb.wasm

# Compiler output (keep the last good version)
!compiler/nurlc_lastgood.ll

# Stdlib runtime objects (rebuilt per platform)
stdlib/runtime.o
stdlib/runtime.native.o
stdlib/runtime.curl
stdlib/runtime.openssl
stdlib/runtime.sqlite3
stdlib/runtime.pq
stdlib/runtime.z
stdlib/runtime.zstd
stdlib/runtime.winlibs
