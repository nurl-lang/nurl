# bench/ build artefacts (regenerated by bench/run.sh + bench/run_http.sh).
# Cargo.lock for the Rust HTTP bench peer IS committed so the captured
# HTTP_RESULTS.md numbers are reproducible against the same crate
# versions on a fresh checkout.
bench/_build/
bench/rust_http_server/target/

