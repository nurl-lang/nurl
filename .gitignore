stdlib/runtime.wasm.o
stdlib/runtime_debug.o
stdlib/runtime_san.o
stdlib/canvas.o
stdlib/canvas.sdl2
stdlib/winlib/

# Test runner output. Per-test goldens live in compiler/tests/outputs/
# and ARE tracked (they are the regression baseline). Everything the
# runner generates at run time goes under build/tests/ (already ignored).
compiler/tests/tmp/
compiler/tests/testresults.txt
compiler/tests/success.txt
compiler/tests/correct.txt
compiler/tests/failures.txt
*.test
test_output/

