{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nurl-docs",
  "compatibility_date": "2026-07-20",
  // The Fumadocs homepage is the front door. `/docs` remains the docs route;
  // Cloudflare owns the custom-domain binding on deploy.
  "routes": [{ "pattern": "nurl-lang.org", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  // Assets-only Worker: serves the static `next build` (output: 'export')
  // output, no Worker script. Search runs against a build-time Orama index
  // fetched and queried client-side (see components/search.tsx) instead of
  // a live API route — see content/docs/fumadocs-migration.mdx for why.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
