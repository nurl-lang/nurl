{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nurl-docs",
  "compatibility_date": "2026-07-20",
  // The Fumadocs homepage is the front door. `/docs` remains the docs route;
  // Cloudflare owns the custom-domain binding on deploy.
  "routes": [{ "pattern": "nurl-lang.org", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  // A small Worker for agents (Markdown content negotiation, Link headers,
  // the API catalog's media type) in front of the static `next build`
  // (output: 'export') in out/. Search runs against a build-time Orama
  // index fetched and queried client-side (see components/search.tsx)
  // instead of a live API route.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths reach the Worker; every other asset (scripts,
    // images, /llms.txt, /sitemap.xml, the rest of /.well-known) is served
    // straight from the asset layer, without a Worker invocation.
    "run_worker_first": ["/", "/docs", "/docs.md", "/docs/*", "/.well-known/api-catalog"]
  }
}
