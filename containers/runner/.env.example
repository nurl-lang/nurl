# Copy to .env (git-ignored) and edit. docker compose reads it.

# The fine-grained PAT, in a file outside the repository. Resource owner
# nurl-lang, organization permission "Self-hosted runners: Read and write",
# nothing else. Windows: C:/Users/<you>/.nurl-runner/github-pat
NURL_RUNNER_PAT_FILE=/home/you/.nurl-runner/github-pat

# Runner names are <prefix>-<slot>-<epoch>. One prefix per machine: the
# supervisor removes stale registrations under its own prefix only.
RUNNER_NAME_PREFIX=my-machine

# How many jobs this machine runs at once. Each slot is a container with its
# own Docker daemon; ci.yml's build jobs use every core they are given.
RUNNER_SLOTS=2

# Labels a workflow selects this pool with (GitHub adds self-hosted, Linux,
# X64 itself): runs-on: [self-hosted, nurl-selfhosted]
RUNNER_LABELS=nurl-selfhosted

# Optional per-slot limits (docker run --cpus / --memory).
#RUNNER_CPUS=8
#RUNNER_MEMORY=12g

# Optional: authenticate the Docker Hub cache (higher pull limits).
#DOCKERHUB_USERNAME=
#DOCKERHUB_TOKEN=

# Optional: pin the actions/runner release (default: the latest).
#RUNNER_VERSION=2.330.0
