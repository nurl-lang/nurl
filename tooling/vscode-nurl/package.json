{
  "name": "nurl",
  "displayName": "NURL Language",
  "description": "Syntax highlighting + Language Server for NURL (Neural Unified Representation Language)",
  "version": "0.3.0",
  "publisher": "nurl-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nurl-lang/nurl"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [{
      "id": "nurl",
      "aliases": ["NURL", "nurl"],
      "extensions": [".nu"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "nurl",
      "scopeName": "source.nurl",
      "path": "./syntaxes/nurl.tmLanguage.json"
    }],
    "configuration": {
      "type": "object",
      "title": "NURL",
      "properties": {
        "nurl.server.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the nurl-lsp binary. Empty string falls back to <workspace>/build/nurl-lsp, then a PATH lookup for 'nurl-lsp'."
        },
        "nurl.server.trace": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace LSP messages exchanged with the server (Output → 'NURL Language Server')."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
