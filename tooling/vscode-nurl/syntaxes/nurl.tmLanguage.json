{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NURL",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#function-def" },
    { "include": "#function-call" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.nurl"
    },
    "strings": {
      "begin": "`",
      "end": "`",
      "name": "string.quoted.backtick.nurl",
      "patterns": [
        {
          "match": "\\\\[nrt\\\\]",
          "name": "constant.character.escape.nurl"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_])pub(?![A-Za-z0-9_])",
          "name": "storage.modifier.visibility.nurl"
        },
        {
          "comment": "Declaration prefixes on `@`: `simd` (grammar v2.6) selects CPU-dispatched code generation, `inline` (v2.7) emits LLVM's alwaysinline. Both are reserved words everywhere, not contextual, so a bare match is correct.",
          "match": "(?<![A-Za-z0-9_])(simd|inline)(?![A-Za-z0-9_])",
          "name": "storage.modifier.nurl"
        },
        {
          "match": "(?<![A-Za-z0-9_])(inout|sink|in)(?![A-Za-z0-9_])",
          "name": "storage.modifier.param.nurl"
        },
        {
          "comment": "Dynamic trait object construction `( dyn Trait value )` (grammar v2.3). `dyn` is a contextual keyword — special only as a call head followed by a trait name (PascalCase by convention) — so it must be matched before #function-call would colour it as an ordinary call.",
          "match": "(\\()\\s*(dyn)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.paren.open.nurl" },
            "2": { "name": "keyword.other.dyn.nurl" },
            "3": { "name": "entity.name.type.trait.nurl" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(T|F)\\b",
          "name": "constant.language.boolean.nurl"
        },
        {
          "match": "(?<![A-Za-z0-9_])-?[0-9]+\\.[0-9]+([eE][\\+\\-]?[0-9]+)?\\b",
          "name": "constant.numeric.float.nurl"
        },
        {
          "match": "(?<![A-Za-z0-9_])-?[0-9]+\\b",
          "name": "constant.numeric.integer.nurl"
        }
      ]
    },
    "function-def": {
      "match": "(@)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.function-def.nurl" },
        "2": { "name": "entity.name.function.nurl" }
      }
    },
    "function-call": {
      "begin": "(\\()\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.paren.open.nurl" },
        "2": { "name": "entity.name.function.call.nurl" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.paren.close.nurl" }
      },
      "patterns": [
        { "include": "$self" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(\\$)\\s*(`[^`]*`)",
          "captures": {
            "1": { "name": "keyword.control.import.nurl" },
            "2": { "name": "string.quoted.backtick.nurl" }
          }
        },
        {
          "match": "(&)\\s*(`[^`]*`)",
          "captures": {
            "1": { "name": "keyword.control.ffi.nurl" },
            "2": { "name": "string.quoted.backtick.nurl" }
          }
        },
        {
          "match": "(%)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.trait.nurl" },
            "2": { "name": "entity.name.type.trait.nurl" }
          }
        },
        {
          "match": "(:)\\s*(\\|)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.enum.nurl" },
            "2": { "name": "keyword.other.enum.nurl" },
            "3": { "name": "entity.name.type.enum.nurl" }
          }
        },
        {
          "match": "(:)\\s*([A-Z][a-zA-Z0-9_]*)\\s*(\\{)",
          "captures": {
            "1": { "name": "keyword.other.struct.nurl" },
            "2": { "name": "entity.name.type.struct.nurl" },
            "3": { "name": "punctuation.brace.open.nurl" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(i8|i16|i32|u16|u32|u64|f32)\\b",
          "name": "storage.type.primitive.sized.nurl"
        },
        {
          "match": "\\b(i|u|f|b|s|v)\\b",
          "name": "storage.type.primitive.nurl"
        },
        {
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
          "name": "entity.name.type.nurl"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "→",
          "name": "keyword.operator.arrow.nurl"
        },
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.variadic.nurl"
        },
        {
          "match": "\\^\\^",
          "name": "keyword.operator.xor.nurl"
        },
        {
          "match": "\\^",
          "name": "keyword.control.return.nurl"
        },
        {
          "match": "\\?\\?",
          "name": "keyword.control.match.nurl"
        },
        {
          "match": "\\?",
          "name": "keyword.control.conditional.nurl"
        },
        {
          "match": "~",
          "name": "keyword.operator.tilde.nurl"
        },
        {
          "match": ";",
          "name": "keyword.control.defer.nurl"
        },
        {
          "match": "\\\\",
          "name": "keyword.operator.try-closure.nurl"
        },
        {
          "match": "Z\\b",
          "name": "keyword.operator.sizeof.nurl"
        },
        {
          "match": "(<<|>>)",
          "name": "keyword.operator.shift.nurl"
        },
        {
          "match": "(==|!=|<=|>=|<|>)",
          "name": "keyword.operator.comparison.nurl"
        },
        {
          "match": "[+\\-*/%]",
          "name": "keyword.operator.arithmetic.nurl"
        },
        {
          "match": "(&&|\\|\\|)",
          "name": "keyword.operator.logical.nurl"
        },
        {
          "match": "[&|!]",
          "name": "keyword.operator.logical.nurl"
        },
        {
          "match": "[=:]",
          "name": "keyword.operator.assignment.nurl"
        },
        {
          "match": "[.#@$%]",
          "name": "keyword.operator.nurl"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[{}]",
          "name": "punctuation.brace.nurl"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.bracket.nurl"
        },
        {
          "match": "[()]",
          "name": "punctuation.paren.nurl"
        }
      ]
    },
    "identifiers": {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.nurl"
    }
  },
  "scopeName": "source.nurl"
}