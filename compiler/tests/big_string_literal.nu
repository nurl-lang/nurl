@ main → i {
    : s d ( big )
    : ~ i len 0
    : ~ i sum 0
    : *u p # *u d
    ~ != # i . p len 0 {
        = sum % + * sum 31 # i . p len 1000000007
        = len + len 1
    }
    ( nurl_print `len=` ) ( nurl_print ( nurl_str_int len ) )
    ( nurl_print ` sum=` ) ( nurl_print ( nurl_str_int sum ) )
    ( nurl_print `\n` )
    ^ 0
}
