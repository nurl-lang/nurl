// ecdsa_p256_sign_vectors.nu — ECDSA P-256 sign-then-verify over 48 keys
// against an independent signer. RFC 6979 makes the signature a pure
// function of (key, message), so every r‖s below is exact: computed by a
// separate RFC 6979 + ECDSA implementation (plain affine arithmetic over
// Python integers, itself checked against RFC 6979 A.2.5), and each one
// verified by pyca/cryptography (OpenSSL), whose key derivation also
// gave the same public point.
//
// The keys are the edges the fixed-base comb and its reduction mod n
// meet — 1, 2, 3, 15‥17, 31‥33 (Booth digits ±1, ±16 and their
// carries), n − 1 (Q = −G), n − 2, n − 16, n − 17, (n ± 1)/2, 2^255,
// 2^255 − 1, 2^128 ± 1, 2^64 + 1, n − 2^128, the 0x55‥/0xAA‥ patterns
// — then pseudo-random ones. Messages run 1 to 769 bytes, across the
// SHA-256 padding boundaries (55/56/64).
//
// For each: the public key from p256_ecdh_keygen must equal the
// reference, the signature must equal the reference byte for byte, it
// must verify, and with one bit of s flipped it must not.

$ `stdlib/core/vec.nu`
$ `stdlib/std/bytes.nu`
$ `stdlib/std/hash_sha256.nu`
$ `stdlib/std/ecdsa_p256.nu`

@ hx s raw → ( Vec u ) { ?? ( bytes_from_hex raw ) { T v → ^ v F _ → ^ ( vec_new [u] ) } }

// 1 when anything about this key disagrees with the reference.
@ case i id s dh s msgh s pubh s sigh → i {
    : ( Vec u ) d ( hx dh )
    : ( Vec u ) h ( sha256_pure ( hx msgh ) )
    : ( Vec u ) pk ( p256_ecdh_keygen d )
    : ( Vec u ) sig ( ecdsa_p256_sign d h )
    : b keyok ( bytes_eq pk ( hx pubh ) )
    : b sigok ( bytes_eq sig ( hx sigh ) )
    : ( Vec u ) r ( bytes_slice sig 0 32 )
    : ( Vec u ) s ( bytes_slice sig 32 64 )
    : b verok ( ecdsa_p256_verify pk r s h )
    ( vec_put [u] s 31 ^^ ?? ( vec_get [u] s 31 ) { T x → x F _ → # u 0 } # u 1 )
    : b tamperok ! ( ecdsa_p256_verify pk r s h )
    ? & & & keyok sigok verok tamperok { ^ 0 } {}
    ( nurl_print `FAIL key ` ) ( nurl_print_int id )
    ? ! keyok { ( nurl_print ` public-key` ) } {}
    ? ! sigok { ( nurl_print ` signature` ) } {}
    ? ! verok { ( nurl_print ` verify` ) } {}
    ? ! tamperok { ( nurl_print ` tamper-accepted` ) } {}
    ( nurl_print `\n` )
    ^ 1
}

