// ecdsa_p384_wycheproof_der.nu — every ECDSA P-384 / SHA-384 case of
// Project Wycheproof in DER form (C2SP/wycheproof,
// testvectors_v1/ecdsa_secp384r1_sha384_test.json, Apache-2.0): 504 cases
// over 105 public keys, 194 valid and 310 invalid, through
// der_ecdsa_sig_rs (std/x509.nu, width 48) and ecdsa_p384_verify — the path
// a TLS 1.3 CertificateVerify and an X.509 chain with a P-384 key take. Most
// invalid cases are encodings, not arithmetic: InvalidEncoding,
// InvalidTypesInSignature, ModifiedSignature, BerEncodedSignature (long-
// form or indefinite lengths), MissingZero (a negative INTEGER), appended
// or truncated bytes, wrong tags. Each must be refused by the decoder or
// the verifier; each valid one must verify (Agora #217).
//
// The digest is SHA-384 of the case's message, computed here. One
// function per Wycheproof test group (one public key); each case is
// `( case tcId valid? key msg sig )`, hex.

$ `stdlib/core/vec.nu`
$ `stdlib/std/bytes.nu`
$ `stdlib/std/hash_sha512.nu`
$ `stdlib/std/ecdsa_p256.nu`
$ `stdlib/std/x509.nu`

: ~ i g_cases 0
: ~ i g_valid 0

@ hx s raw → ( Vec u ) { ?? ( bytes_from_hex raw ) { T v → ^ v F _ → ^ ( vec_new [u] ) } }

// One case: DER-decode the signature, hash the message, verify; 1 on a
// verdict other than Wycheproof's.
@ case i id b want s pk s msg s sig → i {
    = g_cases + g_cases 1
    ? want { = g_valid + g_valid 1 } {}
    : ( Vec u ) sb ( hx sig )
    : ( Vec u ) rs ( der_ecdsa_sig_rs sb 48 )
    : ~ b got F
    ? == ( vec_len [u] rs ) 96 {
        = got ( ecdsa_p384_verify ( hx pk ) ( bytes_slice rs 0 48 ) ( bytes_slice rs 48 96 ) ( sha384_pure ( hx msg ) ) )
    } {}
    ? == got want { ^ 0 } {}
    ( nurl_print `FAIL tcId ` ) ( nurl_print_int id )
    ( nurl_print ? want ` (valid, rejected)\n` ` (invalid, accepted)\n` )
    ^ 1
}

