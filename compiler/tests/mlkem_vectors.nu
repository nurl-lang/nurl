// mlkem_vectors.nu — ML-KEM (FIPS 203) known-answer tests.
//
// Pinned against NIST's ACVP vectors (usnistgov/ACVP-Server,
// gen-val/json-files/ML-KEM-*-FIPS203). Key generation takes only a
// 32-byte d and z, so those cases are carried in full and their large
// outputs pinned by SHA3-256 digest; one encapsulation and one
// decapsulation case for ML-KEM-768 carry their inputs verbatim.
//
// `tools/mlkem_acvp_gate.sh` runs the complete published set — all 180
// cases across the three parameter sets — by fetching the JSON. This
// file is the offline subset that runs on every build.
//
// Two properties beyond the vectors get their own cases:
//
//   * a full keygen → encaps → decaps round trip at every parameter
//     set, which the ACVP vectors never do end to end;
//   * implicit rejection — decapsulating a corrupted ciphertext must
//     return J(z ‖ c), not a failure and not the true shared secret.
//     The expected value is recomputed here straight from SHAKE256 so
//     the check does not depend on mlkem.nu agreeing with itself.

$ `stdlib/std/mlkem.nu`
$ `stdlib/std/hash_sha3.nu`
$ `stdlib/std/bytes.nu`
$ `stdlib/core/vec.nu`
$ `stdlib/core/string.nu`

@ hexv s h → ( Vec u ) {
    : !( Vec u ) ParseErr r ( bytes_from_hex h )
    ?? r { T v → { ^ v } F _e → { ( nurl_panic `mlkem_vectors: bad hex literal` ) ^ ( vec_new [u] ) } }
}

// Compare a byte vector against expected lowercase hex.
@ eq_hex ( Vec u ) got s want → b {
    : String h ( bytes_to_hex got )
    : b ok != 0 ( nurl_str_eq ( string_data h ) want )
    ( string_free h )
    ^ ok
}

// Compare SHA3-256 of a byte vector against expected hex — used where
// the value itself is a kilobyte or more.
@ eq_digest ( Vec u ) got s want → b {
    : ( Vec u ) d ( sha3_256_pure got )
    : b ok ( eq_hex d want )
    ( vec_free [u] d )
    ^ ok
}

@ report s label b ok → b {
    ( nurl_print label )
    ( nurl_print ? ok ` ok\n` ` FAIL\n` )
    ^ ok
}

// ── ACVP key generation: d, z → ek, dk (pinned by digest) ──────────
@ kg_case s label i level s d s z s ekd s dkd → b {
    : ( Vec u ) dv ( hexv d )
    : ( Vec u ) zv ( hexv z )
    : *MlkemKeys ks ( mlkem_keygen_derand level dv zv )
    : b ok1 ( eq_digest ( mlkem_ek ks ) ekd )
    : b ok2 ( eq_digest ( mlkem_dk ks ) dkd )
    // The declared sizes are part of the standard, so check them too.
    : b ok3 == ( vec_len [u] ( mlkem_ek ks ) ) ( mlkem_ek_len level )
    : b ok4 == ( vec_len [u] ( mlkem_dk ks ) ) ( mlkem_dk_len level )
    ( mlkem_keys_free ks )
    ( vec_free [u] zv )
    ( vec_free [u] dv )
    ^ ( report label & & & ok1 ok2 ok3 ok4 )
}

// ── Round trip + implicit rejection, at one parameter set ──────────
@ roundtrip s label i level → b {
    : ( Vec u ) d ( vec_new [u] )
    : ( Vec u ) z ( vec_new [u] )
    : ( Vec u ) m ( vec_new [u] )
    : ~ i i 0
    ~ < i 32 {
        ( vec_push [u] d # u % + * i 7 level 251 )
        ( vec_push [u] z # u % + * i 11 3 251 )
        ( vec_push [u] m # u % + * i 13 5 251 )
        = i + i 1
    }
    : *MlkemKeys ks ( mlkem_keygen_derand level d z )
    : *MlkemEncap en ( mlkem_encaps_derand level ( mlkem_ek ks ) m )
    : b oklen == ( vec_len [u] ( mlkem_ct en ) ) ( mlkem_ct_len level )
    : ( Vec u ) ss ( mlkem_decaps level ( mlkem_dk ks ) ( mlkem_ct en ) )
    : b okrt ( bytes_eq ss ( mlkem_ss en ) )

    // Implicit rejection: flip one bit of the ciphertext. Decapsulation
    // must still return 32 bytes, must not return the true secret, and
    // must return exactly J(z ‖ c') = SHAKE256(z ‖ c', 32).
    : ( Vec u ) bad ( bytes_slice ( mlkem_ct en ) 0 ( vec_len [u] ( mlkem_ct en ) ) )
    : *u bp ( vec_data [u] bad )
    = . bp 0 # u ^^ # i . bp 0 1
    : ( Vec u ) got ( mlkem_decaps level ( mlkem_dk ks ) bad )
    : *Sha3 j ( shake256_init )
    ( sha3_absorb j z )
    ( sha3_absorb j bad )
    : ( Vec u ) want ( sha3_squeeze j 32 )
    ( sha3_free j )
    : b okrej ( bytes_eq got want )
    : b okdiff ! ( bytes_eq got ss )

    ( vec_free [u] want )
    ( vec_free [u] got )
    ( vec_free [u] bad )
    ( vec_free [u] ss )
    ( mlkem_encap_free en )
    ( mlkem_keys_free ks )
    ( vec_free [u] m )
    ( vec_free [u] z )
    ( vec_free [u] d )
    ^ ( report label & & & oklen okrt okrej okdiff )
}

@ main → i {
    : ~ b all T
    = all & all ( kg_case `keygen-512#1    ` 512 `47b893474672ba92e4b12ee44fb32953af8e8503b5fb471d1614fb8a021a660a` `1f8cb39e9e30bc458a0dc5408884b1187fb217018df760fa57317703b844a0a9` `3a389831056ed8fd81476869245782689c84b3ce90fe6a9e78d0a380fd6a1573` `c26aff5b9f97b5b9ca824755d053a1b1aece2b965af6bfbd527b77ea22538468` )
    = all & all ( kg_case `keygen-512#2    ` 512 `3def73c558e1f5f2bfb4f6eaa36ee200cdf54580958cc2176282628ff508a016` `b9958575128f97022525266064f9422e83f75fbdcd0f2bc2648655f0e31a17e5` `52be25fbe4d87aa01253da8891d2592a416e2f791479e50abb19e8f215dd6216` `330ed125d5f61211d8817a7c6f147580c8652040baa682a761b71753d7ce38f0` )
    = all & all ( kg_case `keygen-512#3    ` 512 `309398d92b95b68a725ed55d3e72aa96717fa08a9b919dcdabe7d893a73ad7cc` `c2fe9cb7f49bf7296785a1824cd798c377bff4e1836473cd4a8c7423bf1d0f13` `7ff658bc933fc07e44f8b4b3c3125ff493176d18380c6f7816b229d6d2f56ee3` `69009c2c1b02eca908b4ed986d4c7c767ade1c7213cd32ce8a6953e2295585a1` )
    = all & all ( kg_case `keygen-768#1    ` 768 `e582b7d75e6c80b05ae392a1fc9f7153b12390fd99930368cc67a768baebc8a0` `1cdacb8740c0b87c4a379575f187b367cbfa3b300bf591b109f79816e9cbe8f0` `81e66ef5a7a221619f6a64039cc369843e10df5c859f6959cc3fd8e5272330fd` `be81068c104cd6cf8efd800b294f4a15bb8a8050993fd54a2cc428841ef6ca44` )
    = all & all ( kg_case `keygen-768#2    ` 768 `3e5848db624613f7ac144457cc1375f006fa8cb953e767dc9e7428d00f5dad8b` `012dd6c2f0918b9eb6182474eb86d848f65974759d59ce151a396deee4ca10d1` `423290e0ccb74da11b95294fef12ec690815ff103075053b89c5021aeff4ca0c` `90ed09b739c59ff947f4ac7bc139f5696af8f62bc3b9e655c0437dc36b1c6f54` )
    = all & all ( kg_case `keygen-768#3    ` 768 `882fdea55c6b497a6f2a1321fc82160c630d9a1f2e35bbe0d3332e3a0cfbc8c9` `3a21f601923c559179a3aa5839a148487379eaad934bf27f3071e1b1fdc21d1a` `5f13ee3fd74b1366afa7f3fff4b8f645331db5526fdd7998a4eeb5c27c884db8` `87f070e7884fa5bc66b0712d9fe8098f2d3baf70c4628ec96f2736b407bf4299` )
    = all & all ( kg_case `keygen-1024#1   ` 1024 `f3a706faf090c03db506863ab0b20bd8a1627956318e88c67eb875e8e7266009` `35d2bc43dd1cc879f765bf2a0c5e297889dde910e57e2bb0eae417b90ab7a275` `9370fe5b05ddc92c939f62cbde4c0fea36f45cd20c5748cf3ac891a4c2604496` `b8c683c71564ff8e2391c57b68c3a1ff186734b13e31d2a075b65307c8b80888` )
    = all & all ( kg_case `keygen-1024#2   ` 1024 `52f2df12173088140ca73333d1db4341949be452049028ef0dd904bc7e0ddef7` `cc96de9e1f0506bf490a154a6db46bd2bd1413c3d1dc163190ff171ef0d11e22` `7708c928659dfe465ae813012df3ff6eecb1e081391b0a94172aff81aa3296c4` `5739b6cac0651c4129adc2f34d921703066289089678556ed5462dc297188480` )
    = all & all ( kg_case `keygen-1024#3   ` 1024 `f2a1e83cad0055a85eb52f1bc1b9ee24f7f58d9c2fd099b5d38c9f75ad657578` `26d7035cd963c74ab142936a91eabd3074c583654945f9f5fdc29f754b06ebf2` `249dbfd72887faacdb1b900cfcb5b3955ef374d86072d38ce29dd9e906afd6e3` `fff4dc3d92cdca591af83a60b225d572066a26102567d84f3c9776bb421752dd` )

    // ACVP encapsulation, ML-KEM-768: ek and m verbatim.
    : ( Vec u ) ek768 ( hexv `` )
    : ( Vec u ) m768 ( hexv `4e77596168711e913965d8175ac3bd76aab08b7f9385a02ae883cf6c6e17dd81` )
    : *MlkemEncap en768 ( mlkem_encaps_derand 768 ek768 m768 )
    = all & all ( report `encaps-768      ` & ( eq_digest ( mlkem_ct en768 ) `684da17d93e27520cb78ae6169c020d73ef770e6fa89589cc7d653a76a8b1751` ) ( eq_hex ( mlkem_ss en768 ) `79d74f6c6c2d916bec47bd828fd9b67295a37f54927fab1263c0d122f1c6f1ed` ) )
    ( mlkem_encap_free en768 )
    ( vec_free [u] m768 )
    ( vec_free [u] ek768 )

    // ACVP decapsulation, ML-KEM-768: dk and c verbatim.
    : ( Vec u ) dk768 ( hexv `` )
    : ( Vec u ) ct768 ( hexv `` )
    : ( Vec u ) ss768 ( mlkem_decaps 768 dk768 ct768 )
    = all & all ( report `decaps-768      ` ( eq_hex ss768 `34cfae7f2ca3b0b9c3e06afeed554c053f6e51d875d3bd3ff0eda2086ee79f3a` ) )
    ( vec_free [u] ss768 )
    ( vec_free [u] ct768 )
    ( vec_free [u] dk768 )

    = all & all ( roundtrip `roundtrip-512   ` 512 )
    = all & all ( roundtrip `roundtrip-768   ` 768 )
    = all & all ( roundtrip `roundtrip-1024  ` 1024 )
    ^ ? all 0 1
}
