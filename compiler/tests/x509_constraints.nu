// x509_constraints.nu — regression for the §9 cert-hardening sweep:
// basicConstraints CA flag + pathLen, keyUsage keyCertSign, extendedKeyUsage
// serverAuth, iPAddress SANs, and the tightened wildcard / IP host matching.
// Certs are generated by the audit's gencerts.py (RSA-2048, self-signed).

$ `stdlib/core/string.nu`
$ `stdlib/core/vec.nu`
$ `stdlib/std/bytes.nu`
$ `stdlib/std/x509.nu`

@ hx s raw → ( Vec u ) { ?? ( bytes_from_hex raw ) { T v → v F _ → ( vec_new [u] ) } }
@ yn b x → s { ^ ? x `yes` `no` }

@ main → i {
    // 1. Server leaf: CA:FALSE, EKU serverAuth, KU without keyCertSign,
    //    SAN = { localhost, *.example.com, ip 192.0.2.1 }.
    : ( Vec u ) d1 ( hx `` )
    : X509 c1 ( x509_parse d1 )
    ( nurl_print `leaf: ok=` ) ( nurl_print ( yn . c1 ok ) )
    ( nurl_print ` is_ca=` ) ( nurl_print ( yn . c1 is_ca ) )
    ( nurl_print ` path_len=` ) ( nurl_print ( nurl_str_int . c1 path_len ) )
    ( nurl_print ` has_ku=` ) ( nurl_print ( yn . c1 has_ku ) )
    ( nurl_print ` certSign=` ) ( nurl_print ( yn . c1 ku_cert_sign ) )
    ( nurl_print ` has_eku=` ) ( nurl_print ( yn . c1 has_eku ) )
    ( nurl_print ` serverAuth=` ) ( nurl_print ( yn . c1 eku_server ) )
    ( nurl_print ` sans=` ) ( nurl_print ( nurl_str_int ( vec_len [String] . c1 sans ) ) )
    ( nurl_print ` ipsans=` ) ( nurl_print ( nurl_str_int ( vec_len [String] . c1 ip_sans ) ) ) ( nurl_print `\n` )
    ( nurl_print `match: localhost=` ) ( nurl_print ( yn ( x509_matches_host c1 `localhost` ) ) )
    ( nurl_print ` a.example.com=` ) ( nurl_print ( yn ( x509_matches_host c1 `a.example.com` ) ) )
    ( nurl_print ` example.com=` ) ( nurl_print ( yn ( x509_matches_host c1 `example.com` ) ) )
    ( nurl_print ` ip=` ) ( nurl_print ( yn ( x509_matches_host c1 `192.0.2.1` ) ) )
    ( nurl_print ` ip2=` ) ( nurl_print ( yn ( x509_matches_host c1 `192.0.2.2` ) ) ) ( nurl_print `\n` )

    // 2. Intermediate-shaped CA: CA:TRUE pathLen=0, keyUsage keyCertSign.
    : ( Vec u ) d2 ( hx `` )
    : X509 c2 ( x509_parse d2 )
    ( nurl_print `ca: ok=` ) ( nurl_print ( yn . c2 ok ) )
    ( nurl_print ` is_ca=` ) ( nurl_print ( yn . c2 is_ca ) )
    ( nurl_print ` path_len=` ) ( nurl_print ( nurl_str_int . c2 path_len ) )
    ( nurl_print ` certSign=` ) ( nurl_print ( yn . c2 ku_cert_sign ) ) ( nurl_print `\n` )

    // 3. clientAuth-only leaf: EKU present but NOT serverAuth.
    : ( Vec u ) d3 ( hx `` )
    : X509 c3 ( x509_parse d3 )
    ( nurl_print `client: has_eku=` ) ( nurl_print ( yn . c3 has_eku ) )
    ( nurl_print ` serverAuth=` ) ( nurl_print ( yn . c3 eku_server ) ) ( nurl_print `\n` )

    ( x509_free c1 ) ( x509_free c2 ) ( x509_free c3 )
    ( vec_free [u] d1 ) ( vec_free [u] d2 ) ( vec_free [u] d3 )
    ^ 0
}
