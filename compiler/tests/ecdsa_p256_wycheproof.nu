// ecdsa_p256_wycheproof.nu — every ECDSA P-256 / SHA-256 case of Project
// Wycheproof in IEEE P1363 form (C2SP/wycheproof,
// testvectors_v1/ecdsa_secp256r1_sha256_p1363_test.json, Apache-2.0): 262
// cases over 112 public keys, 173 valid and 89 invalid. The flags name what
// the cases aim at: ArithmeticError (r, s and digests that walk the carry
// and reduction edges of GF(n) and GF(p)), SpecialCaseHash,
// EdgeCasePublicKey (coordinates near 0 and p), PointDuplication and
// EdgeCaseShamirMultiplication (u1·G + u2·Q meeting the doubling and
// infinity cases of the Straus–Shamir pass), ModularInverse, SmallRandS,
// RangeCheck and IntegerOverflow (r or s of 0, n, n + small, p),
// InvalidSignature and SignatureSize.
//
// A P1363 signature is exactly r‖s, 32 bytes each; any other length is
// not a P-256 signature and is rejected before verify, as a P1363
// decoder does. The digest is SHA-256 of the case's message, computed
// here. One function per Wycheproof test group (one public key); each
// case is `( case tcId valid? key msg sig )`, hex.

$ `stdlib/core/vec.nu`
$ `stdlib/std/bytes.nu`
$ `stdlib/std/hash_sha256.nu`
$ `stdlib/std/ecdsa_p256.nu`

: ~ i g_cases 0
: ~ i g_valid 0

@ hx s raw → ( Vec u ) { ?? ( bytes_from_hex raw ) { T v → ^ v F _ → ^ ( vec_new [u] ) } }

// One case: P1363-decode the signature, hash the message, verify; 1 on
// a verdict other than Wycheproof's.
@ case i id b want s pk s msg s sig → i {
    = g_cases + g_cases 1
    ? want { = g_valid + g_valid 1 } {}
    : ( Vec u ) sb ( hx sig )
    : ~ b got F
    ? == ( vec_len [u] sb ) 64 {
        = got ( ecdsa_p256_verify ( hx pk ) ( bytes_slice sb 0 32 ) ( bytes_slice sb 32 64 ) ( sha256_pure ( hx msg ) ) )
    } {}
    ? == got want { ^ 0 } {}
    ( nurl_print `FAIL tcId ` ) ( nurl_print_int id )
    ( nurl_print ? want ` (valid, rejected)\n` ` (invalid, accepted)\n` )
    ^ 1
}

