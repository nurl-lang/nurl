// Per-table x extent (max x index + 1).
@ _mp3_hxlen → ( Vec i ) {
    : ( Vec i ) v ( _mp3_zeros 40 )
    : *i p ( vec_data [i] v )
    : ~ i at 0
    = at ( _mp3_pl8 p at 0 2 3 3 0 4 4 6 )  // 0
    = at ( _mp3_pl8 p at 6 6 8 8 8 16 0 16 )  // 8
    = at ( _mp3_pl8 p at 16 16 16 16 16 16 16 16 )  // 16
    = at ( _mp3_pl8 p at 16 16 16 16 16 16 16 16 )  // 24
    = at ( _mp3_pl8 p at 1 1 0 0 0 0 0 0 )  // 32
    ^ v
}

// Per-table y extent; the pair (x,y) indexes at x*ylen + y.
@ _mp3_hylen → ( Vec i ) {
    : ( Vec i ) v ( _mp3_zeros 40 )
    : *i p ( vec_data [i] v )
    : ~ i at 0
    = at ( _mp3_pl8 p at 0 2 3 3 0 4 4 6 )  // 0
    = at ( _mp3_pl8 p at 6 6 8 8 8 16 0 16 )  // 8
    = at ( _mp3_pl8 p at 16 16 16 16 16 16 16 16 )  // 16
    = at ( _mp3_pl8 p at 16 16 16 16 16 16 16 16 )  // 24
    = at ( _mp3_pl8 p at 16 16 0 0 0 0 0 0 )  // 32
    ^ v
}

// Escape-value width in bits, 0 for the tables without one.
@ _mp3_hlinbits → ( Vec i ) {
    : ( Vec i ) v ( _mp3_zeros 40 )
    : *i p ( vec_data [i] v )
    : ~ i at 0
    = at ( _mp3_pl8 p at 0 0 0 0 0 0 0 0 )  // 0
    = at ( _mp3_pl8 p at 0 0 0 0 0 0 0 0 )  // 8
    = at ( _mp3_pl8 p at 1 2 3 4 6 8 10 13 )  // 16
    = at ( _mp3_pl8 p at 4 5 6 7 8 9 11 13 )  // 24
    = at ( _mp3_pl8 p at 0 0 0 0 0 0 0 0 )  // 32
    ^ v
}

// Largest value an escape of that width can carry.
@ _mp3_hlinmax → ( Vec i ) {
    : ( Vec i ) v ( _mp3_zeros 40 )
    : *i p ( vec_data [i] v )
    : ~ i at 0
    = at ( _mp3_pl8 p at 0 0 0 0 0 0 0 0 )  // 0
    = at ( _mp3_pl8 p at 0 0 0 0 0 0 0 0 )  // 8
    = at ( _mp3_pl8 p at 1 3 7 15 63 255 1023 8191 )  // 16
    = at ( _mp3_pl8 p at 15 31 63 127 255 511 2047 8191 )  // 24
    = at ( _mp3_pl8 p at 0 0 0 0 0 0 0 0 )  // 32
    ^ v
}

// Where each table's data starts in the two flat arrays.
@ _mp3_hoff → ( Vec i ) {
    : ( Vec i ) v ( _mp3_zeros 40 )
    : *i p ( vec_data [i] v )
    : ~ i at 0
    = at ( _mp3_pl8 p at 0 0 4 13 0 22 38 54 )  // 0
    = at ( _mp3_pl8 p at 90 126 162 226 290 354 0 610 )  // 8
    = at ( _mp3_pl8 p at 866 866 866 866 866 866 866 866 )  // 16
    = at ( _mp3_pl8 p at 1122 1122 1122 1122 1122 1122 1122 1122 )  // 24
    = at ( _mp3_pl8 p at 1378 1394 0 0 0 0 0 0 )  // 32
    ^ v
}

