// packages/audio/src/mp3tab.nu — the constants MPEG-1/2 Layer III is made of.
//
// None of this is a choice. Every number here is fixed by ISO/IEC 11172-3 and
// 13818-3, and every encoder and every decoder in the world carries the same
// ones: the Huffman code books of Table B.7, the scalefactor band boundaries
// of Table B.8 (MPEG-1) and B.2 (MPEG-2 and 2.5), and the 512-tap analysis
// window of Annex C. They live in their own file because they are data, not
// code, and because mp3.nu reads better without 400 lines of digits in the
// middle of it.
//
// The Huffman books are stored as two flat arrays — one of code words, one of
// their lengths in bits — with a per-book starting offset, because the books
// are of wildly different sizes (4 entries for book 1, 256 for book 24) and a
// jagged array of 34 separate allocations would be slower to reach into and no
// clearer to read. A pair (x, y) is at `off + x * ylen + y`.
//
// Books 16..23 all share one code table and differ only in `linbits`, the
// width of the escape field that carries values above 14; books 24..31 do the
// same with a second table. That sharing is in the standard, not a trick here.

$ `stdlib/core/vec.nu`

@ _mp3_zeros i n → ( Vec i ) {
    : ( Vec i ) v ( vec_with_cap [i] n )
    : ~ i k 0
    ~ < k n { ( vec_push [i] v 0 ) = k + k 1 }
    ^ v
}

@ _mp3_fzeros i n → ( Vec f ) {
    : ( Vec f ) v ( vec_with_cap [f] n )
    : ~ i k 0
    ~ < k n { ( vec_push [f] v 0.0 ) = k + k 1 }
    ^ v
}

// Eight at a time: the tables below are long, and one call per value would
// make them longer still.
@ _mp3_pl8 * i p i at i a i b i c i d i e i f i g i h → i {
    = . p + at 0 a
    = . p + at 1 b
    = . p + at 2 c
    = . p + at 3 d
    = . p + at 4 e
    = . p + at 5 f
    = . p + at 6 g
    = . p + at 7 h
    ^ + at 8
}

@ _mp3_pf8 * f p i at f v0 f v1 f v2 f v3 f v4 f v5 f v6 f v7 → i {
    = . p + at 0 v0
    = . p + at 1 v1
    = . p + at 2 v2
    = . p + at 3 v3
    = . p + at 4 v4
    = . p + at 5 v5
    = . p + at 6 v6
    = . p + at 7 v7
    ^ + at 8
}

@ _mp3_hcode → ( Vec i ) {
    : ( Vec i ) v ( _mp3_zeros 1416 )
    : *i p ( vec_data [i] v )
    : ~ i at 0
    = at ( _mp3_pl8 p at 1 1 1 0 1 2 1 3 )  // 0
    = at ( _mp3_pl8 p at 1 1 3 2 0 3 2 1 )  // 8
    = at ( _mp3_pl8 p at 1 1 1 3 2 0 1 2 )  // 16
