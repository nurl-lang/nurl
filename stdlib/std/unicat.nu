: ( Arc ( Vec i ) ) g_uc_n ( __uc_n_make )

@ __uc_s_make → ( Arc ( Vec i ) ) {
    : ( Vec i ) v ( vec_with_cap [i] 20 )
    ( vec_push [i] v 9 ) ( vec_push [i] v 13 ) ( vec_push [i] v 28 ) ( vec_push [i] v 32 ) ( vec_push [i] v 133 ) ( vec_push [i] v 133 ) ( vec_push [i] v 160 ) ( vec_push [i] v 160 ) ( vec_push [i] v 5760 ) ( vec_push [i] v 5760 ) ( vec_push [i] v 8192 ) ( vec_push [i] v 8202 ) ( vec_push [i] v 8232 ) ( vec_push [i] v 8233 ) ( vec_push [i] v 8239 ) ( vec_push [i] v 8239 )
